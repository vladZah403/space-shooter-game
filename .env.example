# Скопируйте этот файл в .env и заполните своими значениями.
# .env не коммитится в git (см. .gitignore).

# Токен бота от @BotFather
BOT_TOKEN=

# Ваш Telegram numeric ID (узнать: @userinfobot). Нужен, чтобы получать предложения игроков.
ADMIN_CHAT_ID=

# URL, на котором размещена игра (GitHub Pages и т.п.)
GAME_URL=https://vladzah403.github.io/space-shooter-game/

# HTTP API лидерборда (api.py) — обычно можно не задавать, по умолчанию 0.0.0.0:8080.
# На хостинге, который сам назначает порт (Render/Railway/Fly.io), там уже есть своя
# переменная PORT — api.py её подхватит автоматически, ничего указывать не нужно.
# API_HOST=0.0.0.0
# API_PORT=8080
